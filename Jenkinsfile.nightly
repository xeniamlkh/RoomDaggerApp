pipeline {
    agent { label 'android' }

    triggers { cron('H 2 * * *') }

    options {
        timeout(time: 180, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        BASELINE_DIR = '/home/jenkins/agent/baseline'
    }

    stages {
        stage('Prepare') {
            steps { sh 'chmod +x gradlew' }
        }

        // Сборка + замеры
        stage('Benchmark') {
            steps {
                sh '''
                    gradle-profiler --benchmark \
                      --scenario-file performance.scenarios \
                      --project-dir . \
                      --output-dir profile-out
                '''
            }
        }

        stage('Anomaly check') {
            steps {
                sh '''
                    mkdir -p "$BASELINE_DIR"
                    FAILED=0

                    # Считаем среднее по строкам "measured build" для каждого сценария
                    awk -F, '
                      $1=="scenario" { for (i=2;i<=NF;i++) name[i]=$i; n=NF }
                      $1 ~ /^measured build/ { for (i=2;i<=NF;i++) { sum[i]+=$i; cnt[i]++ } }
                      END { for (i=2;i<=n;i++) if (cnt[i]>0) print name[i], int(sum[i]/cnt[i]+0.5) }
                    ' profile-out/benchmark.csv > profile-out/means.txt

                    # Если средних нет, формат CSV изменился: падаем
                    [ -s profile-out/means.txt ] || { echo "Не удалось посчитать средние из benchmark.csv"; exit 1; }

                    while read NAME MEAN; do
                        echo "$NAME: среднее $MEAN мс"
                        BASE_FILE="$BASELINE_DIR/$NAME.txt"

                        if [ -f "$BASE_FILE" ]; then
                            BASE=$(cat "$BASE_FILE")
                            CHANGE=$(awk -v m="$MEAN" -v b="$BASE" 'BEGIN { printf "%.1f", (m/b - 1) * 100 }')
                            echo "  база $BASE мс, изменение $CHANGE%"
                            # Порог 1.15 = +15%
                            if awk -v m="$MEAN" -v b="$BASE" 'BEGIN { exit !(m/b > 1.15) }'; then
                                echo "  АНОМАЛИЯ: медленнее базы больше чем на 15%"
                                FAILED=1
                                continue
                            fi
                        fi
                        echo "$MEAN" > "$BASE_FILE"
                    done < profile-out/means.txt

                    exit $FAILED
                '''
            }
        }

    post {
        always {
            archiveArtifacts artifacts: 'profile-out/**', allowEmptyArchive: true
        }
        cleanup { cleanWs() }
    }
  }
}